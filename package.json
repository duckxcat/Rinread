{
  "name": "wereader",
  "version": "1.0.0",
  "description": "粼青之海 - 本地电子书阅读器",
  "main": "main.js",
  "author": "liuch",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.liuch.wereader",
    "productName": "粼青之海",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "粼青之海.exe"
    }
  }
}
